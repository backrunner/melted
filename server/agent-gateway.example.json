{
  "listen_host": "0.0.0.0",
  "port": 8430,
  "data_directory": "/data",
  "dsh_package_directory": "/opt/dsh/node_modules/@deepseek-ai/dsh",
  "access_token_env": "MELTED_AGENT_GATEWAY_TOKEN",
