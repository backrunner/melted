# Generate a URL-safe password, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=replace-with-generated-password
MELTED_SERVER_ID=replace-with-stable-server-id
MELTED_OPERATOR=Melted
PUBLIC_ORIGIN=https://melted.example.com
REGISTRATION_MODE=key
