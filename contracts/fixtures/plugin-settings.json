      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "route",
            "label": "订阅路由",
            "help": "选择订阅建议，或填写运营者允许的相对路由；无需实例地址",
            "required": true,
            "type": "text",
            "placeholder": "/bbc/world-asia",
            "max_length": 2048,
            "monospaced": true,
            "suggestions": [
