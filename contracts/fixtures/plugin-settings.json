{
  "dsl_version": 1,
  "source_form": {
    "fields": [
      {
        "id": "name",
        "label": "名称",
        "required": true,
        "type": "text",
        "max_length": 200
      },
      {
        "id": "enabled",
        "label": "自动采集",
        "required": true,
        "type": "boolean",
        "default": true
      },
      {
        "id": "interval_seconds",
        "label": "采集间隔",
        "required": true,
        "type": "integer",
        "default": 900,
        "minimum": 300,
        "maximum": 86400,
        "step": 1,
        "unit": "秒",
        "suggestions": [
          {
            "value": 300,
            "label": "每 5 分钟"
          },
          {
            "value": 900,
            "label": "每 15 分钟"
          },
          {
            "value": 1800,
            "label": "每 30 分钟"
          },
          {
            "value": 3600,
            "label": "每小时"
          },
          {
            "value": 21600,
            "label": "每 6 小时"
          },
          {
            "value": 86400,
            "label": "每天"
          }
        ]
      }
    ]
  },
  "plugins": [
    {
