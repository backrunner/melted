{
  "dsl_version": 1,
  "source_form": {
    "fields": [
      {
        "id": "name",
        "label": "名称",
        "required": true,
        "type": "text",
        "placeholder": "例如：世界新闻",
        "max_length": 200
      },
      {
        "id": "enabled",
        "label": "自动采集",
        "required": true,
        "type": "boolean",
        "default": true
      },
      {
        "id": "interval_seconds",
        "label": "采集间隔",
        "required": true,
        "type": "integer",
        "default": 900,
        "minimum": 300,
        "maximum": 86400,
        "step": 1,
        "unit": "秒",
        "suggestions": [
          {
            "value": 300,
            "label": "每 5 分钟"
          },
          {
            "value": 900,
            "label": "每 15 分钟"
          },
          {
            "value": 1800,
            "label": "每 30 分钟"
          },
          {
            "value": 3600,
            "label": "每小时"
          },
          {
            "value": 21600,
            "label": "每 6 小时"
          },
          {
            "value": 86400,
            "label": "每天"
          }
        ]
      }
    ]
  },
  "plugins": [
    {
      "dsl_version": 1,
      "id": "rsshub",
      "version": "1.0.0",
      "title": "RSSHub",
      "description": "订阅新闻、文化生活、社区等公开来源，保存当前订阅窗口中的原始内容",
      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "route",
            "label": "订阅路由",
            "help": "从实例目录选择来源，或填写运营者允许的相对路由；无需实例地址",
            "required": true,
            "type": "text",
            "placeholder": "/bbc/world-asia",
            "max_length": 2048,
            "monospaced": true
          }
        ]
      },
      "collection": {
        "layout": "table",
        "title": "订阅",
        "columns": [
          {
            "scope": "source",
            "field": "name",
            "label": "名称"
          },
          {
            "scope": "configuration",
            "field": "route",
            "label": "订阅路由"
          },
          {
            "scope": "source",
            "field": "enabled",
            "label": "状态"
          },
          {
            "scope": "source",
            "field": "interval_seconds",
            "label": "采集间隔"
          }
        ],
        "primary_field": "route",
        "preset_catalog": {
          "field": "route",
          "maximum": 20
        }
      },
      "actions": [
        {
          "id": "sync",
          "label": "立即采集",
          "description": "创建后台采集任务，可查看实际入库结果",
          "effect": "collect",
          "input": {
            "fields": []
          }
        },
        {
          "id": "validate",
          "label": "检查配置",
          "description": "检查路由格式与运营者授权范围，不发起网络请求",
          "effect": "validate",
          "input": {
            "fields": []
          }
        }
      ],
      "available": true,
      "unavailable_reason": null
    },
    {
      "dsl_version": 1,
      "id": "feed",
      "version": "1.0.0",
      "title": "RSS / Atom",
      "description": "直接订阅网站的 RSS、Atom 或 JSON Feed",
      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "url",
            "label": "订阅地址",
            "help": "填写完整的 Feed 地址，网站首页不会自动查找订阅链接",
            "required": true,
            "type": "text",
            "placeholder": "https://example.com/feed.xml",
            "max_length": 2048,
            "format": "url"
          },
          {
            "id": "format",
            "label": "Feed 格式",
            "required": true,
            "type": "select",
            "default": "auto",
            "options": [
              {
                "value": "auto",
                "label": "自动识别"
              },
              {
                "value": "rss",
                "label": "RSS 2.0"
              },
              {
                "value": "atom",
                "label": "Atom 1.0"
              },
              {
                "value": "json",
                "label": "JSON Feed"
              }
            ]
          },
          {
            "id": "max_items",
            "label": "单次条数上限",
            "help": "按 Feed 的条目顺序读取，最多保存前 100 条；不回填历史",
            "required": true,
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 100,
            "step": 1,
            "suggestions": [
              {
                "value": 20,
                "label": "20 条"
              },
              {
                "value": 50,
                "label": "50 条"
              },
              {
                "value": 100,
                "label": "100 条"
              }
            ]
          }
        ]
      },
      "collection": {
        "layout": "table",
        "title": "订阅",
        "columns": [
          {
            "scope": "source",
            "field": "name",
            "label": "名称"
          },
          {
            "scope": "configuration",
            "field": "url",
            "label": "订阅地址"
          },
          {
            "scope": "source",
            "field": "enabled",
            "label": "状态"
          },
          {
            "scope": "source",
            "field": "interval_seconds",
            "label": "采集间隔"
          }
        ],
        "primary_field": "url"
      },
      "actions": [
        {
          "id": "sync",
          "label": "立即采集",
          "description": "从 Feed 获取当前条目",
          "effect": "collect",
          "input": {
            "fields": []
          }
        },
        {
          "id": "validate",
          "label": "检查配置",
          "description": "检查地址格式、允许的站点与采集设置",
          "effect": "validate",
          "input": {
            "fields": []
          }
        }
      ],
      "available": true,
      "unavailable_reason": null
    },
    {
      "dsl_version": 1,
      "id": "bluesky",
      "version": "1.0.0",
      "title": "Bluesky",
      "description": "订阅 Bluesky 账号和自定义 Feed 的公开帖子",
      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "mode",
            "label": "订阅类型",
            "required": true,
            "type": "select",
            "default": "author",
            "options": [
              {
                "value": "author",
                "label": "账号"
              },
              {
                "value": "feed",
                "label": "自定义 Feed"
              }
            ]
          },
          {
            "id": "target",
            "label": "订阅目标",
            "help": "账号填写 handle 或 DID；自定义 Feed 填写 at://…/app.bsky.feed.generator/…",
            "required": true,
            "type": "text",
            "placeholder": "bsky.app",
            "max_length": 1000
          },
          {
            "id": "include_replies",
            "label": "包含回复",
            "required": true,
            "type": "boolean",
            "default": true
          },
          {
            "id": "include_reposts",
            "label": "包含转发",
            "required": true,
            "type": "boolean",
            "default": false
          },
          {
            "id": "max_items",
            "label": "单次条数上限",
            "help": "采集最新窗口，不回填完整历史",
            "required": true,
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100,
            "step": 1
          }
        ]
      },
      "collection": {
        "layout": "table",
        "title": "订阅",
        "columns": [
          {
            "scope": "source",
            "field": "name",
            "label": "名称"
          },
          {
            "scope": "configuration",
            "field": "target",
            "label": "订阅目标"
          },
          {
            "scope": "source",
            "field": "enabled",
            "label": "状态"
          },
          {
            "scope": "source",
            "field": "interval_seconds",
            "label": "采集间隔"
          }
        ]
      },
      "actions": [
        {
          "id": "sync",
          "label": "立即采集",
          "description": "获取当前公开内容",
          "effect": "collect",
          "input": {
            "fields": []
          }
        },
        {
          "id": "validate",
          "label": "检查配置",
          "description": "检查订阅目标与服务器授权",
          "effect": "validate",
          "input": {
            "fields": []
          }
        }
      ],
      "available": true,
      "unavailable_reason": null
    },
    {
      "dsl_version": 1,
      "id": "fediverse",
      "version": "1.0.0",
      "title": "Fediverse",
      "description": "订阅 Mastodon 兼容实例的公开账号和话题",
      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "instance",
            "label": "实例",
            "required": true,
            "type": "select",
            "default": "https://mastodon.social",
            "options": [
              {
                "value": "https://mastodon.social",
                "label": "mastodon.social"
              }
            ]
          },
          {
            "id": "mode",
            "label": "订阅类型",
            "required": true,
            "type": "select",
            "default": "account",
            "options": [
              {
                "value": "account",
                "label": "账号"
              },
              {
                "value": "hashtag",
                "label": "话题"
              }
            ]
          },
          {
            "id": "target",
            "label": "订阅目标",
            "help": "账号不要加开头的 @，话题不要加 #；远程账号须已被所选实例发现",
            "required": true,
            "type": "text",
            "placeholder": "用户名@实例 或话题名称",
            "max_length": 320
          },
          {
            "id": "include_replies",
            "label": "包含回复",
            "required": true,
            "type": "boolean",
            "default": true
          },
          {
            "id": "include_boosts",
            "label": "包含转嘟",
            "required": true,
            "type": "boolean",
            "default": false
          },
          {
            "id": "max_items",
            "label": "单次条数上限",
            "help": "采集最新公开窗口，最多 40 条",
            "required": true,
            "type": "integer",
            "default": 40,
            "minimum": 1,
            "maximum": 40,
            "step": 1
          }
        ]
      },
      "collection": {
        "layout": "table",
        "title": "订阅",
        "columns": [
          {
            "scope": "source",
            "field": "name",
            "label": "名称"
          },
          {
            "scope": "configuration",
            "field": "target",
            "label": "订阅目标"
          },
          {
            "scope": "configuration",
            "field": "instance",
            "label": "实例"
          },
          {
            "scope": "source",
            "field": "enabled",
            "label": "状态"
          }
        ]
      },
      "actions": [
        {
          "id": "sync",
          "label": "立即采集",
          "description": "获取当前公开内容",
          "effect": "collect",
          "input": {
            "fields": []
          }
        },
        {
          "id": "validate",
          "label": "检查配置",
          "description": "检查订阅目标与服务器授权",
          "effect": "validate",
          "input": {
            "fields": []
          }
        }
      ],
      "available": true,
      "unavailable_reason": null
    },
    {
      "dsl_version": 1,
      "id": "nostr",
      "version": "1.0.0",
      "title": "Nostr",
      "description": "从公开 relay 订阅已验证签名的短帖和长文",
      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "relay",
            "label": "Relay",
            "required": true,
            "type": "select",
            "default": "wss://relay.damus.io/",
            "options": [
              {
                "value": "wss://relay.damus.io/",
                "label": "wss://relay.damus.io/"
              }
            ]
          },
          {
            "id": "mode",
            "label": "订阅类型",
            "required": true,
            "type": "select",
            "default": "author",
            "options": [
              {
                "value": "author",
                "label": "作者"
              },
              {
                "value": "hashtag",
                "label": "话题"
              }
            ]
          },
          {
            "id": "target",
            "label": "订阅目标",
            "help": "作者填写 npub 公钥或 64 位十六进制公钥；话题不加 #，按原文匹配；不要输入私钥",
            "required": true,
            "type": "text",
            "placeholder": "npub1… 或话题名称",
            "max_length": 200
          },
          {
            "id": "kind",
            "label": "内容类型",
            "required": true,
            "type": "select",
            "default": "notes",
            "options": [
              {
                "value": "notes",
                "label": "短帖"
              },
              {
                "value": "articles",
                "label": "长文"
              }
            ]
          },
          {
            "id": "max_items",
            "label": "单次条数上限",
            "help": "采集最新窗口，不回填完整历史",
            "required": true,
            "type": "integer",
            "default": 50,
            "minimum": 1,
            "maximum": 100,
            "step": 1
          }
        ]
      },
      "collection": {
        "layout": "table",
        "title": "订阅",
        "columns": [
          {
            "scope": "source",
            "field": "name",
            "label": "名称"
          },
          {
            "scope": "configuration",
            "field": "target",
            "label": "订阅目标"
          },
          {
            "scope": "configuration",
            "field": "relay",
            "label": "Relay"
          },
          {
            "scope": "source",
            "field": "enabled",
            "label": "状态"
          }
        ]
      },
      "actions": [
        {
          "id": "sync",
          "label": "立即采集",
          "description": "获取当前公开内容",
          "effect": "collect",
          "input": {
            "fields": []
          }
        },
        {
          "id": "validate",
          "label": "检查配置",
          "description": "检查订阅目标与服务器授权",
          "effect": "validate",
          "input": {
            "fields": []
          }
        }
      ],
      "available": true,
      "unavailable_reason": null
    },
    {
      "dsl_version": 1,
      "id": "deepseek-harness",
      "version": "1.0.0",
      "title": "DeepSeek Harness",
      "description": "让 Agent 在授权网站中寻找符合目标的信息",
      "kind": "collector",
      "config_version": 1,
      "capabilities": [
        "collector.poll"
      ],
      "form": {
        "fields": [
          {
            "id": "profile",
            "label": "采集环境",
            "required": true,
            "type": "select",
            "default": "public",
            "options": [
              {
                "value": "public",
                "label": "公开文化来源"
              }
            ]
          },
          {
            "id": "goal",
            "label": "采集目标",
            "help": "目标及抓取的公开内容会发送给模型；自动采集会持续消耗模型额度",
            "required": true,
            "type": "text",
            "placeholder": "例如：寻找近期城市文化活动，保留原始介绍",
            "max_length": 2000
          },
          {
            "id": "start_url",
            "label": "起始地址",
            "help": "公开网页或 Feed，必须属于采集环境授权的网站",
            "required": true,
            "type": "text",
            "max_length": 2048,
            "format": "url"
          },
          {
            "id": "lookback_hours",
            "label": "关注最近",
            "help": "供 Agent 筛选参考；缺少发布时间的来源仍可能保留",
            "required": true,
            "type": "integer",
            "default": 24,
            "minimum": 1,
            "maximum": 168,
            "step": 1,
            "unit": "小时"
          },
          {
            "id": "max_items",
            "label": "单次条数上限",
            "required": true,
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 20,
            "step": 1
          },
          {
            "id": "max_requests",
            "label": "单次网页请求上限",
            "required": true,
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 10,
            "step": 1
          },
          {
            "id": "timeout_seconds",
            "label": "单次运行时限",
            "required": true,
            "type": "integer",
            "default": 45,
            "minimum": 15,
            "maximum": 60,
            "step": 1,
            "unit": "秒"
          }
        ]
      },
      "collection": {
        "layout": "list",
        "title": "采集任务",
        "columns": [
          {
            "scope": "source",
            "field": "name",
            "label": "名称"
          },
          {
            "scope": "configuration",
            "field": "goal",
            "label": "采集目标"
          },
          {
            "scope": "configuration",
            "field": "profile",
            "label": "采集环境"
          },
          {
            "scope": "source",
            "field": "enabled",
            "label": "状态"
          }
        ],
        "primary_field": "goal"
      },
      "actions": [
        {
          "id": "sync",
          "label": "立即采集",
          "description": "启动一次 Agent 采集任务",
          "effect": "collect",
          "input": {
            "fields": []
          },
          "confirmation": "此次采集会调用模型并消耗额度"
        },
        {
          "id": "validate",
          "label": "检查配置",
          "description": "检查采集环境与起始地址授权",
          "effect": "validate",
          "input": {
            "fields": []
          }
        }
      ],
      "available": true,
      "unavailable_reason": null
    }
  ]
}
