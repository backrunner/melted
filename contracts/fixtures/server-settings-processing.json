{
  "dsl_version": 1,
  "sections": [
    {
      "id": "preferences",
      "schema_version": 1,
      "title": "内容与输出偏好",
      "description": "描述你希望看到的内容，以及分类和输出方式，留空表示不指定",
      "form": {
        "fields": [
          {
            "id": "classification",
            "label": "分类与标签",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：按文化、生活、工作分类，为提到的城市和人物添加标签",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "content",
            "label": "想看到的内容",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：关注本地文化活动、阅读和公共服务变化，少看重复推广",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "preferences",
            "label": "个人偏好",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：保留不同观点；信息不确定时明确说明，不替我推断立场",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "output",
            "label": "输出偏好",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：使用简体中文，先给摘要，再列关键事实和来源，语气简洁",
            "max_length": 4096,
            "multiline": true
          }
        ]
      },
      "load": {
        "method": "GET",
        "path": "/v1/settings/preferences"
      },
      "save": {
        "method": "PUT",
        "path": "/v1/settings/preferences",
        "format": "versioned-values-v1",
        "max_bytes": 32768,
        "label": "保存偏好"
      },
      "workflow": {
        "format": "processing-actions-v1",
        "fingerprint": "0935dfcb93a33b0921a2c1c8772a5d129a54ef175571f5fd14ae886e41192efd",
        "status": {
          "method": "GET",
          "path": "/v1/settings/preferences/processing"
        },
        "actions": [
          {
            "id": "compile",
            "label": "生成整理规则",
            "method": "POST",
            "path": "/v1/settings/preferences/compile",
            "enabled_phases": [
              "stored",
              "failed",
              "consent_required"
            ],
            "confirmation": "将本版偏好发送至 https://generator.example、https://api.typesafe.ai 生成整理规则并消耗模型额度。确认启用后，已采集的公开来源内容也将发送至这些服务用于分类、筛选、生成与材料检查。原始资料会保留"
          },
          {
            "id": "activate",
            "label": "启用整理规则",
            "method": "POST",
            "path": "/v1/settings/preferences/activate",
            "enabled_phases": [
              "ready"
            ],
            "confirmation": "按这些规则处理已采集及后续新增的公开来源内容，调用已声明的模型并消耗额度；旧版生成结果将由当前版本重新整理"
          },
          {
            "id": "reprocess",
            "label": "重试失败任务",
            "method": "POST",
            "path": "/v1/settings/preferences/reprocess",
            "enabled_phases": [
              "active"
            ],
            "confirmation": "重新执行当前版本失败的整理任务，可能再次产生模型费用；已成功的任务不会重复处理"
          }
        ]
      }
    }
  ]
}
