{
  "dsl_version": 1,
  "sections": [
    {
      "id": "preferences",
      "schema_version": 1,
      "title": "内容与输出偏好",
      "description": "描述你希望看到的内容，以及分类和输出方式，留空表示不指定",
      "form": {
        "fields": [
          {
            "id": "classification",
            "label": "分类与标签",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：按文化、生活、工作分类，为提到的城市和人物添加标签",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "content",
            "label": "想看到的内容",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：关注本地文化活动、阅读和公共服务变化，少看重复推广",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "preferences",
            "label": "个人偏好",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：保留不同观点；信息不确定时明确说明，不替我推断立场",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "output",
            "label": "输出偏好",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：使用简体中文，先给摘要，再列关键事实和来源，语气简洁",
            "max_length": 4096,
            "multiline": true
          }
        ]
      },
      "load": {
        "method": "GET",
        "path": "/v1/settings/preferences"
      },
      "save": {
        "method": "PUT",
        "path": "/v1/settings/preferences",
        "format": "versioned-values-v1",
        "max_bytes": 32768,
        "label": "保存偏好"
      }
    }
  ],
  "credentials": [
    {
      "id": "model_credentials",
      "scope": "account",
      "title": "我的模型凭据（BYOK）",
      "description": "仅用于当前账户的整理任务，不与其他账户共用。生成模型：example-model（https://generator.example）；判断模型：jev-latest（https://api.typesafe.ai）。密钥写入服务器后加密保存，不回显",
      "fields": [
        {
          "id": "generator_key",
          "type": "secret",
          "label": "生成模型 API Key",
          "placeholder": "输入新密钥，留空保留已保存密钥",
          "max_length": 4096
        },
        {
          "id": "decision_key",
          "type": "secret",
          "label": "Jev API Key",
          "placeholder": "输入新密钥，留空保留已保存密钥",
          "max_length": 4096
        }
      ],
      "load": {
        "method": "GET",
        "path": "/v1/settings/credentials/account"
      },
      "save": {
        "method": "POST",
        "path": "/v1/settings/credentials/account",
        "format": "write-only-secrets-v1",
        "label": "保存凭据",
        "confirmation": "将密钥保存到当前服务器，仅供本账户整理任务使用。保存不验证密钥有效性；变更后需要重新编译并确认偏好，已发出的模型请求可能仍产生费用"
      }
    }
  ]
}
