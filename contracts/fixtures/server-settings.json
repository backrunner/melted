{
  "dsl_version": 1,
  "sections": [
    {
      "id": "preferences",
      "schema_version": 1,
      "title": "内容与输出偏好",
      "description": "描述你希望看到的内容，以及分类和输出方式，留空表示不指定",
      "form": {
        "fields": [
          {
            "id": "classification",
            "label": "分类与标签",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：按文化、生活、工作分类，为提到的城市和人物添加标签",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "content",
            "label": "想看到的内容",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：关注本地文化活动、阅读和公共服务变化，少看重复推广",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "preferences",
            "label": "个人偏好",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：保留不同观点；信息不确定时明确说明，不替我推断立场",
            "max_length": 4096,
            "multiline": true
          },
          {
            "id": "output",
            "label": "输出偏好",
            "required": false,
            "type": "text",
            "default": "",
            "placeholder": "例如：使用简体中文，先给摘要，再列关键事实和来源，语气简洁",
            "max_length": 4096,
            "multiline": true
          }
        ]
      },
      "load": {
        "method": "GET",
        "path": "/v1/settings/preferences"
      },
      "save": {
        "method": "PUT",
        "path": "/v1/settings/preferences",
        "format": "versioned-values-v1",
        "max_bytes": 32768,
        "label": "保存偏好"
      }
    }
  ]
}
